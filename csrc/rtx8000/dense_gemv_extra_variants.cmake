file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/dense_gemv_extra_variants.inc"
  RTX8000_DENSE_GEMV_EXTRA_PLANS REGEX "^RTX_DENSE_GEMV_EXTRA")
set(RTX8000_DENSE_GEMV_EXTRA_SOURCES)
foreach(RTX8000_DENSE_GEMV_EXTRA_PLAN IN LISTS RTX8000_DENSE_GEMV_EXTRA_PLANS)
  string(REGEX REPLACE "^RTX_DENSE_GEMV_EXTRA\\(([0-9]+)\\).*" "\\1"
    RTX8000_DENSE_GEMV_EXTRA_M "${RTX8000_DENSE_GEMV_EXTRA_PLAN}")
  list(APPEND RTX8000_DENSE_GEMV_EXTRA_SOURCES
    "${CMAKE_CURRENT_LIST_DIR}/dense_gemv_m${RTX8000_DENSE_GEMV_EXTRA_M}.cu")
endforeach()
