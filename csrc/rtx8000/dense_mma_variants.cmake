file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/dense_mma_variants.inc"
  RTX8000_DENSE_MMA_PLANS REGEX "^RTX_DENSE_MMA_VARIANT")
set(RTX8000_DENSE_MMA_SOURCES)
foreach(RTX8000_DENSE_MMA_PLAN IN LISTS RTX8000_DENSE_MMA_PLANS)
  string(REGEX REPLACE "^RTX_DENSE_MMA_VARIANT\\([0-9]+, *([a-z0-9_]+),.*" "\\1"
    RTX8000_DENSE_MMA_NAME "${RTX8000_DENSE_MMA_PLAN}")
  list(APPEND RTX8000_DENSE_MMA_SOURCES
    "${CMAKE_CURRENT_LIST_DIR}/dense_mma_${RTX8000_DENSE_MMA_NAME}.cu")
endforeach()
